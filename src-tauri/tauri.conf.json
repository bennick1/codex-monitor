{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Monitor",
  "version": "1.1.0",
  "identifier": "app.quotafloat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "Codex Monitor",
        "width": 80,
        "height": 80,
        "minWidth": 80,
        "minHeight": 80,
        "maxWidth": 314,
        "maxHeight": 514,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Codex quota and token usage at a glance",
    "longDescription": "A lightweight, local-first desktop monitor for Codex quota, reset times, and token usage on this machine.",
    "copyright": "Copyright Quota Float contributors and Codex Monitor contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
